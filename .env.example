# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Serveur uniquement. Ne jamais préfixer par NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Paystack (clé secrète du compte ; sert aussi à signer les webhooks)
PAYSTACK_SECRET_KEY=

# Secret des tâches planifiées Vercel (Authorization: Bearer ...)
CRON_SECRET=

# URL publique du site
NEXT_PUBLIC_SITE_URL=https://localhost:3000

# IA (optionnel ; hors chemin de paiement)
ASV_KEY_OPENROUTER=
ASV_KEY_GROQ=
ASV_KEY_DEEPSEEK=

# Administration (obligatoire pour /admin)
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=
# E-mails transactionnels (Resend)
RESEND_API_KEY=
MAIL_FROM=
# Détection VPN optionnelle
IPQS_API_KEY=
# Modèles IA (avec les clés ASV_KEY_*)
ASV_MODEL_OPENROUTER=
ASV_MODEL_GROQ=
ASV_MODEL_DEEPSEEK=
