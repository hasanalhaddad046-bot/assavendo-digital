# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Serveur uniquement. Ne jamais préfixer par NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Paystack (clés uniquement côté serveur)
PAYSTACK_SECRET_KEY=
# Secret de signature Paystack-Signature moderne, distinct de la clé API
PAYSTACK_WEBHOOK_SECRET=

# Secret des tâches planifiées Vercel (Authorization: Bearer ...)
CRON_SECRET=

# URL publique du site
NEXT_PUBLIC_SITE_URL=https://localhost:3000

# IA (optionnel ; hors chemin de paiement)
ASV_KEY_OPENROUTER=
ASV_KEY_GROQ=
ASV_KEY_DEEPSEEK=
# Manus API v2 (copilote / tâches longues)
MANUS_API_KEY=

# Protection anti-bot Cloudflare Turnstile (facultatif, activée uniquement si les deux clés sont définies)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Administration (obligatoire pour /admin)
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=
# E-mails transactionnels (Resend)
RESEND_API_KEY=
MAIL_FROM=
# Détection VPN optionnelle
IPQS_API_KEY=
# Modèles IA (avec les clés ASV_KEY_*)
ASV_MODEL_OPENROUTER=
ASV_MODEL_GROQ=
ASV_MODEL_DEEPSEEK=

# Tanzania local collections — disabled until MALIPOPAY KYC and go-live approval
# Switch PAYMENT_PROVIDER to malipopay only after the account and dropshipping activity are approved.
PAYMENT_PROVIDER=paystack
MALIPOPAY_ENABLED=false
MALIPOPAY_ACCOUNT_APPROVED=false
MALIPOPAY_DROPSHIPPING_APPROVED=false
MALIPOPAY_CURRENCY=TZS
MALIPOPAY_API_KEY=
MALIPOPAY_WEBHOOK_SECRET=
